App(
    appid="flipper_esp32_over_ble",
    name="ESP32 over BLE",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipper_esp32_over_ble_app",
    # Unity build (TP-15 follow-up): flipper_esp32_over_ble.c is the sole TU for the app's
    # own 12 split modules -- it #include's the other 11 module .c files directly (see its
    # own top-of-file comment). Do not list them here too; APP_FN/APP_DATA in app_internal.h
    # expand to 'static' and require being compiled as one translation unit.
    sources=["flipper_esp32_over_ble.c", "framing.c", "cbor_primitives.c", "cbor_records.c", "cbor_wifi_scan.c", "cbor_ble_scan.c", "cbor_wardriving.c", "cbor_gps.c", "cbor_meshcore.c", "cbor_mesh_log.c", "wardriving_csv.c", "mesh_nodes.c", "pairing_crypto.c", "pairing.c", "session_crypto.c", "session.c"],
    requires=["gui", "bt"],
    stack_size=4 * 1024,
    fap_category="Connectivity",
    targets=["f7"],
)